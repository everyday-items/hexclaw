{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexclaw.net/contracts/k12-image-task.v1.schema.json",
  "title": "K12ImageTaskV1",
  "oneOf": [
    { "$ref": "#/$defs/createResponse" },
    { "$ref": "#/$defs/dispatchResponse" },
    { "$ref": "#/$defs/resultResponse" },
    { "$ref": "#/$defs/problemSourceActionResponse" }
  ],
  "$defs": {
    "progress": {
      "type": "object",
      "required": ["operation", "state"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "groundingEvidenceReceipt": {
      "type": "object",
      "required": [
        "textbook_binding_id",
        "textbook_manifest_id",
        "document_id",
        "document_generation",
        "vector_revision_id",
        "query_digest",
        "chunk_id",
        "logical_page",
        "pdf_page",
        "source_digest",
        "citation_digest"
      ],
      "properties": {
        "textbook_binding_id": { "type": "string", "minLength": 1 },
        "textbook_manifest_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "document_generation": { "type": "integer", "minimum": 1 },
        "vector_revision_id": { "type": "string", "minLength": 1 },
        "query_digest": { "type": "string", "minLength": 1 },
        "chunk_id": { "type": "string", "minLength": 1 },
        "logical_page": { "type": "integer", "minimum": 1 },
        "pdf_page": { "type": "integer", "minimum": 1 },
        "source_digest": { "type": "string", "minLength": 1 },
        "citation_digest": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "problemGroundingReceipt": {
      "type": "object",
      "required": [
        "problem_id",
        "operation",
        "identity_digest",
        "textbook_binding_id",
        "textbook_manifest_id",
        "document_id",
        "document_generation",
        "vector_revision_id",
        "query_digest",
        "chunk_id",
        "logical_page",
        "pdf_page",
        "source_digest",
        "citation_digest"
      ],
      "properties": {
        "problem_id": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["solve", "grade"] },
        "identity_digest": { "type": "string", "minLength": 1 },
        "textbook_binding_id": { "type": "string", "minLength": 1 },
        "textbook_manifest_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "document_generation": { "type": "integer", "minimum": 1 },
        "vector_revision_id": { "type": "string", "minLength": 1 },
        "query_digest": { "type": "string", "minLength": 1 },
        "chunk_id": { "type": "string", "minLength": 1 },
        "logical_page": { "type": "integer", "minimum": 1 },
        "pdf_page": { "type": "integer", "minimum": 1 },
        "source_digest": { "type": "string", "minLength": 1 },
        "citation_digest": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "operationReceipt": {
      "type": "object",
      "required": [
        "invocation_id",
        "operation",
        "execution_kind",
        "canonical_input_digest",
        "status",
        "attempt",
        "result_digest"
      ],
      "properties": {
        "invocation_id": { "type": "string", "minLength": 1 },
        "parent_invocation_id": { "type": "string", "minLength": 1 },
        "physical_unit": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "execution_kind": { "enum": ["provider", "local_deterministic"] },
        "canonical_input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "result_digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "request_policy_digest": { "type": "string", "minLength": 1 },
        "request_policy": {
          "type": "object",
          "required": ["policy_version", "stage", "thinking", "reasoning_effort"],
          "properties": {
            "policy_version": { "type": "string", "minLength": 1 },
            "stage": { "type": "string", "minLength": 1 },
            "thinking": { "type": "string", "minLength": 1 },
            "reasoning_effort": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "execution_kind": { "const": "provider" } },
            "required": ["execution_kind"]
          },
          "then": { "required": ["provider", "model"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["provider"] },
                { "required": ["model"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["homework_submission", "creative_work_intake"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dispatch": {
      "type": "object",
      "required": [
        "dispatch_id",
        "task_intent",
        "status",
        "intent_evidence",
        "intent_confidence",
        "confirmation_candidates",
        "progress",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "dispatch_id": { "type": "string", "minLength": 1 },
        "task_intent": { "enum": ["completed_homework", "blank_worksheet", "writing", "artwork", "unknown"] },
        "status": { "enum": ["routing", "awaiting_confirmation", "routed", "failed", "cancelled"] },
        "provider_display_name": { "type": ["string", "null"] },
        "model_id": { "type": ["string", "null"] },
        "retryable": { "type": "boolean" },
        "failure_kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9_]*[a-z0-9])?$"
        },
        "intent_evidence": { "type": "array", "items": { "type": "string" } },
        "intent_confidence": { "type": "number" },
        "confirmation_candidates": { "type": "array", "items": { "type": "string" } },
        "target": { "$ref": "#/$defs/target" },
        "progress": { "$ref": "#/$defs/progress" },
        "target_projection": {
          "type": "object",
          "properties": {
            "grounding_evidence_receipts": {
              "type": "array",
              "items": { "$ref": "#/$defs/groundingEvidenceReceipt" }
            },
            "problem_grounding_receipts": {
              "type": "array",
              "items": { "$ref": "#/$defs/problemGroundingReceipt" }
            }
          }
        },
        "version": { "type": "integer" },
        "created_at": { "type": "integer" },
        "updated_at": { "type": "integer" },
        "automatic_budget_seconds": { "type": "integer" },
        "automatic_started_at": { "type": "integer" },
        "automatic_deadline_at": { "type": "integer" },
        "automatic_remaining_seconds": { "type": "integer" },
        "operation_deadline_at": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "createResponse": {
      "type": "object",
      "required": ["created", "dispatch"],
      "properties": {
        "created": { "type": "boolean" },
        "dispatch": { "$ref": "#/$defs/dispatch" }
      },
      "additionalProperties": false
    },
    "dispatchResponse": {
      "type": "object",
      "required": ["dispatch"],
      "properties": { "dispatch": { "$ref": "#/$defs/dispatch" } },
      "additionalProperties": false
    },
    "resultResponse": {
      "type": "object",
      "required": ["dispatch_id", "task_intent", "status", "result"],
      "properties": {
        "dispatch_id": { "type": "string", "minLength": 1 },
        "task_intent": { "enum": ["completed_homework", "blank_worksheet", "writing", "artwork", "unknown"] },
        "status": { "enum": ["routing", "awaiting_confirmation", "routed", "failed", "cancelled"] },
        "failure_kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9_]*[a-z0-9])?$"
        },
        "result": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind", "payload"],
              "properties": {
                "kind": { "enum": ["completed_homework", "blank_worksheet", "writing", "artwork"] },
                "payload": { "type": "object" }
              },
              "additionalProperties": false
            }
          ]
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_attachments": { "type": "array", "items": { "type": "object" } },
        "operation_receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/operationReceipt" }
        },
        "grounding_evidence_receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/groundingEvidenceReceipt" }
        },
        "problem_grounding_receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/problemGroundingReceipt" }
        }
      },
      "additionalProperties": false
    },
    "problemSourceAction": {
      "enum": ["correct_text", "select_region", "retake", "skip", "resume"]
    },
    "sourcePixelRegion": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "problemSourceProgress": {
      "type": "object",
      "required": [
        "problem_id",
        "status",
        "input_revision",
        "published_revision",
        "current_disposition"
      ],
      "properties": {
        "problem_id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "awaiting_source",
            "processing",
            "skipped",
            "correct",
            "correct_with_process_issue",
            "wrong",
            "unanswered",
            "answer_unclear",
            "blank_solved",
            "out_of_scope",
            "untrusted"
          ]
        },
        "input_revision": { "type": "integer", "minimum": 1 },
        "published_revision": { "type": "integer", "minimum": 0 },
        "current_disposition": { "const": "current" },
        "page_asset_id": { "type": "string", "minLength": 1 },
        "source_width": { "type": "integer", "minimum": 1 },
        "source_height": { "type": "integer", "minimum": 1 },
        "source_region": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sourcePixelRegion" }
          ]
        }
      },
      "additionalProperties": false
    },
    "problemSourceCoverage": {
      "type": "object",
      "required": [
        "total",
        "published",
        "skipped",
        "awaiting",
        "failed",
        "status",
        "projection_revision"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "published": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "awaiting": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["empty", "in_progress", "complete"] },
        "projection_revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "problemSourceProgressiveSnapshot": {
      "type": "object",
      "required": [
        "structure_version",
        "snapshot_revision",
        "problem_progress",
        "coverage"
      ],
      "properties": {
        "structure_version": { "type": "integer", "minimum": 1 },
        "snapshot_revision": { "type": "integer", "minimum": 0 },
        "problem_progress": {
          "type": "array",
          "items": { "$ref": "#/$defs/problemSourceProgress" }
        },
        "coverage": { "$ref": "#/$defs/problemSourceCoverage" }
      },
      "additionalProperties": false
    },
    "problemSourceActionResponse": {
      "type": "object",
      "required": [
        "command_receipt_id",
        "dispatch_id",
        "problem_id",
        "action",
        "structure_version",
        "input_revision",
        "progressive_snapshot"
      ],
      "properties": {
        "command_receipt_id": { "type": "string", "minLength": 1 },
        "dispatch_id": { "type": "string", "minLength": 1 },
        "problem_id": { "type": "string", "minLength": 1 },
        "action": { "$ref": "#/$defs/problemSourceAction" },
        "structure_version": { "type": "integer", "minimum": 1 },
        "input_revision": { "type": "integer", "minimum": 1 },
        "progressive_snapshot": {
          "$ref": "#/$defs/problemSourceProgressiveSnapshot"
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "command_receipt_id": "source-action-receipt-contract-1",
          "dispatch_id": "dispatch-source-action",
          "problem_id": "problem-source-action",
          "action": "skip",
          "structure_version": 1,
          "input_revision": 1,
          "progressive_snapshot": {
            "structure_version": 1,
            "snapshot_revision": 1,
            "problem_progress": [
              {
                "problem_id": "problem-source-action",
                "status": "skipped",
                "input_revision": 1,
                "published_revision": 1,
                "current_disposition": "current",
                "page_asset_id": "asset://mingming/431ced6916a2a21a156e38701afe55bbd7f88969fbbfc56d7fe099d47f265460.png",
                "source_width": 1,
                "source_height": 1,
                "source_region": null
              }
            ],
            "coverage": {
              "total": 1,
              "published": 0,
              "skipped": 1,
              "awaiting": 0,
              "failed": 0,
              "status": "complete",
              "projection_revision": 1
            }
          }
        }
      ]
    }
  }
}
